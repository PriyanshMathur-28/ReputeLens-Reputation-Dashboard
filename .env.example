# ==============================================================================
# ReputeLens Environment Variables Configuration
# NOTE: ALL variables are OPTIONAL! The application starts and runs with ZERO keys.
# ==============================================================================

# Server Port (default: 3001)
PORT=3001

# Database Connection (Optional)
# If provided, connects to PostgreSQL (e.g. Supabase, Neon, Railway, or Replit Postgres).
# If omitted, automatically falls back to embedded PGlite at data/reputelens.db.
# DATABASE_URL=postgresql://postgres:password@localhost:5432/reputelens

# ── AI / LLM Provider (Optional) ──────────────────────────────────────────────
# If provided, all AI features (Ask ReputeLens, Explain Spike, Briefings) are
# powered by a live LLM. Without a key, 100% offline rule-based mode is used.
#
# RECOMMENDED: Groq (free tier, fastest inference)
# GROQ_API_KEY=gsk_...
#
# Fallback: OpenAI
# OPENAI_API_KEY=sk-...
#
# Override auto-detection (options: groq | openai | offline):
# LLM_PROVIDER=groq

# ── External Social Ingestion Connectors (Optional) ───────────────────────────
# Free connectors (Google News RSS & Hacker News) work with zero keys.
# Reddit & YouTube use pre-generated realistic demo data if no key is provided.
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=reputelens-bot/1.0
# YOUTUBE_API_KEY=

# ── Optional Security Password Gate ───────────────────────────────────────────
# If set, prompts for this password before accessing the dashboard.
# If omitted, dashboard is open for demo/presentation.
# APP_PASSWORD=

# ── Netlify / Frontend Deployment ─────────────────────────────────────────────
# Only needed if deploying the frontend to Netlify with a separate backend.
# VITE_API_URL=https://your-backend.up.railway.app
